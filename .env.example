# PostgreSQL (docker compose)
DATABASE_URL="postgresql://fonte:fonte@localhost:5432/fonte_publica?schema=public"

# App
# Em produção (Railway), defina a URL pública, ex.:
# NEXT_PUBLIC_SITE_URL="https://fonte-publica-production.up.railway.app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TZ="America/Sao_Paulo"

# Ingestão PNCP
PNCP_BASE_URL="https://pncp.gov.br/api/consulta"
PNCP_RATE_LIMIT_MS="350"
PNCP_MAX_RETRIES="5"

# Railway: no serviço web, em Variables, vincule o Postgres ou defina:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
# (sem isso a busca falha com "Environment variable not found: DATABASE_URL")
