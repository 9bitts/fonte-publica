# PostgreSQL (docker compose)
DATABASE_URL="postgresql://fonte:fonte@localhost:5432/fonte_publica?schema=public"

# App
# Em produção (Railway), defina a URL pública, ex.:
# NEXT_PUBLIC_SITE_URL="https://fontepublica.org"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TZ="America/Sao_Paulo"

# Ingestão PNCP (API de CONSULTA pública — Manual Integração v2.5 §5.4)
# NÃO use https://pncp.gov.br/api/pncp aqui (essa base é para publicação com JWT).
PNCP_BASE_URL="https://pncp.gov.br/api/consulta"
PNCP_RATE_LIMIT_MS="350"
PNCP_MAX_RETRIES="8"

# Railway: no serviço web, em Variables, vincule o Postgres ou defina:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
# (sem isso a busca falha com "Environment variable not found: DATABASE_URL")

# Cron de ingestão (serviço separado — ver railway.ingest.toml / README):
# INGEST_DIAS="2"
# INGEST_UF=
# INGEST_LIMITE=

